#!/usr/bin/env bash

# vim: foldmethod=marker

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: dotfiles-manager OPTIONS... [--] COMPONENTS...

If empty, `COMPONENTS...` defaults to all components if `--list` or `--install`
is given, otherwise to all existing components.

Options:
  --list     List components
  --nuke     Delete components (after confirmation prompt)
  --install  Install components
  --update   Update components

  --self     Include the `dotfiles-manager` itself in the set of available
             components. With `--install`/`--update`, the running script does
             not automatically call the new version of itself; this requires a
             manual second run.

  --dry      Run only "preflight" checks for the requested actions, then quit
  --help     Show this help message

A script to install/update my dotfiles. This generally excludes any
machine-specific system configuration, but includes user configuration of shell
utilities and some GUI apps.

The script runs up to four sequential actions in the following order, with each
action being enabled through its corresponding flag:
- `--list`: List the selected components (as YAML):
  - Whether they exist
  - Whether they are in a modified (or otherwise unexpected / "dirty") state
  - The associated managed paths
- `--nuke`: Delete the managed paths associated with the selected components
- `--install`: Git-clone (or otherwise write) the selected components if they do
  not exist already
- `--update`: Git-pull (or otherwise update) the selected components if they are
  in a clean state

Post-hooks are run for some components after install/update. The script is
generally conservative and always prefers aborting over overwriting any
unexpected state.
EOF
}

# To add a new component,
# - Add its name in `components`
# - Add 6 functions:
#   - `paths_…`: Managed paths associated with the component
#   - `exists_…`: Does the component already exist?
#   - `dirty_…`: Is the state unexpected/modified/dirty?
#   - `install_…`: Initial installation
#   - `update_…`: Update of an existing installation
#   - `post_…`: Post-install/update hook

# TODO: Add `aerc` (link to local repo?) and `nnn` components once the repos
# exist
# TODO: Potentially do a `post_nvim` if there is a good way to do it (better
# than `nvim -c "sleep 15 | qall"`). For installing plugins and treesitter
# languages, essentially. The actual scripting logic may belong in the
# config-nvim repository.

# Argument parsing {{{1

do_list=0
do_nuke=0
do_install=0
do_update=0
include_self=0
dry_run=0
requested_components=()

while (($#)); do
  case "$1" in
    --list)
      do_list=1
      ;;
    --nuke)
      do_nuke=1
      ;;
    --install)
      do_install=1
      ;;
    --update)
      do_update=1
      ;;
    --self)
      include_self=1
      ;;
    --dry)
      dry_run=1
      ;;
    --help)
      usage
      exit 0
      ;;
    --)
      shift
      while (($#)); do
        requested_components+=("$1")
        shift
      done
      break
      ;;
    -*)
      printf 'Unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
    *)
      requested_components+=("$1")
      ;;
  esac

  shift
done

if ((do_list == 0 && do_nuke == 0 && do_install == 0 && do_update == 0)); then
  printf 'No action specified. See --help.\n' >&2
  exit 2
fi

if ! command -v git >/dev/null; then
  printf 'Cannot run: git is not available.\n' >&2
  exit 1
fi

# Helpers {{{1

contains() {
  local needle="$1"
  local item
  shift

  for item in "$@"; do
    if [[ "${item}" == "${needle}" ]]; then
      return 0
    fi
  done

  return 1
}

yaml_quote() {
  local value="$1"

  value="${value//\'/\'\'}"
  printf "'%s'" "${value}"
}

path_exists() {
  [[ -e "$1" || -L "$1" ]]
}

component_call() {
  local action="$1"
  local component="$2"

  "${action}_${component}"
}

component_state() {
  local component="$1"

  if ! component_call exists "${component}"; then
    printf 'absent\n'
  elif component_call dirty "${component}"; then
    printf 'dirty\n'
  else
    printf 'clean\n'
  fi
}

any() {
  local predicate="$1"
  local producer="$2"
  local item

  while IFS= read -r item; do
    if "${predicate}" "${item}"; then
      return 0
    fi
  done < <("${producer}")

  return 1
}

parent_is_creatable() {
  local path="$1"
  local parent
  local next

  parent="$(dirname "${path}")"

  while ! path_exists "${parent}"; do
    next="$(dirname "${parent}")"
    if [[ "${next}" == "${parent}" ]]; then
      break
    fi
    parent="${next}"
  done

  [[ -d "${parent}" && -w "${parent}" && -x "${parent}" ]]
}

text_file_dirty() {
  local path="$1"
  local writer="$2"

  if ! path_exists "${path}"; then
    return 1
  fi

  if [[ -L "${path}" || ! -f "${path}" ]]; then
    return 0
  fi

  if cmp -s "${path}" <("${writer}"); then
    return 1
  fi

  return 0
}

ensure_link() {
  local target="$1"
  local link="$2"

  if path_exists "${link}"; then
    if [[ ! -L "${link}" || "$(readlink "${link}")" != "${target}" ]]; then
      printf 'Unexpected existing path: %s\n' "${link}" >&2
      return 1
    fi
  else
    ln -s "${target}" "${link}"
  fi
}

repo_dirty() {
  local url="$1"
  local path="$2"
  local actual_url
  local status
  local upstream

  if ! path_exists "${path}"; then
    return 1
  fi

  if [[ -L "${path}" || ! -d "${path}/.git" ]]; then
    return 0
  fi

  actual_url="$(
    git -C "${path}" config --get remote.origin.url 2>/dev/null
  )" || return 0

  if [[ "${actual_url}" != "${url}" ]]; then
    return 0
  fi

  status="$(git -C "${path}" status --porcelain 2>/dev/null)" || return 0

  if [[ -n "${status}" ]]; then
    return 0
  fi

  if ! git -C "${path}" symbolic-ref -q HEAD >/dev/null 2>&1; then
    return 0
  fi

  upstream="$(
    git -C "${path}" \
      rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null
  )" || return 0

  if [[ "${upstream}" != origin/* ]]; then
    return 0
  fi

  if ! git -C "${path}" \
    merge-base --is-ancestor HEAD '@{u}' >/dev/null 2>&1; then
    return 0
  fi

  return 1
}

install_repo() {
  local url="$1"
  local path="$2"

  mkdir -p "$(dirname "${path}")"
  git clone "${url}" "${path}"
}

update_repo() {
  local path="$1"

  git -C "${path}" pull --ff-only
}

# Components and definitions {{{1

components=(
  git
  less
  fish
  nvim
  tmux
  cpcp
)

if ((include_self)); then
  components+=(self)
fi

home="${HOME:?}"
config_home="${XDG_CONFIG_HOME:-${home}/.config}"

# Component: git {{{1

paths_git() {
  printf '%s\n' \
    "${config_home}/git" \
    "${home}/.gitconfig"
}

exists_git() {
  any path_exists paths_git
}

dirty_git() {
  local repo="${config_home}/git"
  local link="${home}/.gitconfig"
  local target="${repo}/gitconfig"

  if ! exists_git; then
    return 1
  fi

  if ! path_exists "${repo}" || [[ ! -L "${link}" ]]; then
    return 0
  fi

  if repo_dirty \
    https://github.com/publik-void/config-git.git \
    "${repo}"; then
    return 0
  fi

  if [[ "$(readlink "${link}")" != "${target}" ]]; then
    return 0
  fi

  return 1
}

install_git() {
  install_repo \
    https://github.com/publik-void/config-git.git \
    "${config_home}/git"
}

update_git() {
  update_repo "${config_home}/git"
}

post_git() {
  local link="${home}/.gitconfig"
  local target="${config_home}/git/gitconfig"

  if [[ -L "${link}" && "$(readlink "${link}")" == "${target}" ]]; then
    return
  fi

  ln -s "${target}" "${link}"
}

# Component: less {{{1

less_level() {
  local version
  version="$(LC_ALL=C less --version 2>/dev/null)" || {
    printf '596\n'
    return
  }

  if [[ ! "${version}" =~ ^less[[:space:]]+([0-9]+) ]]; then
    printf '596\n'
  elif ((BASH_REMATCH[1] < 582)); then
    printf '581\n'
  elif ((BASH_REMATCH[1] < 596)); then
    printf '582\n'
  else
    printf '596\n'
  fi
}

paths_less() {
  printf '%s\n' \
    "${config_home}/less" \
    "${config_home}/lesskey" \
    "${home}/.lesskey" \
    "${home}/.less"
}

exists_less() {
  any path_exists paths_less
}

dirty_less() {
  local repo="${config_home}/less"
  local source="${repo}/lesskey"
  local config_link="${config_home}/lesskey"
  local home_link="${home}/.lesskey"
  local binary="${home}/.less"
  local level

  if ! path_exists "${repo}" || repo_dirty \
    https://github.com/publik-void/config-less.git "${repo}"; then
    return 0
  fi

  if [[ ! -L "${config_link}" ]] ||
    [[ "$(readlink "${config_link}")" != "${source}" ]]; then
    return 0
  fi

  level="$(less_level)"

  if ((level < 596)); then
    if [[ ! -L "${home_link}" ]] ||
      [[ "$(readlink "${home_link}")" != "${config_link}" ]]; then
      return 0
    fi
  elif path_exists "${home_link}"; then
    return 0
  fi

  if ((level < 582)); then
    if path_exists "${binary}" &&
      { [[ ! -f "${binary}" ]] || [[ -L "${binary}" ]]; }; then
      return 0
    fi
  elif path_exists "${binary}"; then
    return 0
  fi

  return 1
}

install_less() {
  install_repo \
    https://github.com/publik-void/config-less.git \
    "${config_home}/less"
}

update_less() {
  update_repo "${config_home}/less"
}

post_less() {
  local repo="${config_home}/less"
  local config_link="${config_home}/lesskey"
  local level
  local tmp

  level="$(less_level)"
  mkdir -p "${config_home}"

  ensure_link "${repo}/lesskey" "${config_link}"

  if ((level < 596)); then
    ensure_link "${config_link}" "${home}/.lesskey"
  fi

  if ((level < 582)); then
    if command -v lesskey >/dev/null 2>&1; then
      tmp="$(mktemp "${home}/.less.XXXXXX")"

      if ! lesskey -o "${tmp}" "${repo}/lesskey"; then
        rm -f -- "${tmp}"
        return 1
      fi

      mv -- "${tmp}" "${home}/.less"
    else
      printf 'Warning: less <582 requires lesskey to compile ~/.less.\n' >&2
    fi
  fi
}

