# Component selection {{{1

selected_components=()

if ((${#requested_components[@]})); then
  for component in "${requested_components[@]}"; do
    if ! contains "${component}" "${components[@]}"; then
      printf 'Unknown component: %s\n' "${component}" >&2
      printf 'Valid components:' >&2
      printf ' %s' "${components[@]}" >&2
      printf '\n' >&2
      exit 2
    fi

    if ((${#selected_components[@]} == 0)) ||
      ! contains "${component}" "${selected_components[@]}"; then
      selected_components+=("${component}")
    fi
  done
elif ((do_list || do_install)); then
  selected_components=("${components[@]}")
else
  for component in "${components[@]}"; do
    if component_call exists "${component}"; then
      selected_components+=("${component}")
    fi
  done
fi

if ((${#selected_components[@]} == 0)); then
  printf 'No components selected.\n'
  exit 0
fi

# Run {{{1

preflight_install_paths() {
  local component="$1"
  local path

  while IFS= read -r path; do
    if ! parent_is_creatable "${path}"; then
      printf \
        'Cannot install %s: parent path for %s is not creatable.\n' \
        "${component}" "${path}" >&2
      return 1
    fi
  done < <(component_call paths "${component}")
}

preflight() {
  local component
  local state
  local installed_in_run
  local failed=0

  for component in "${selected_components[@]}"; do
    state="$(component_state "${component}")"
    installed_in_run=0

    if ((do_nuke)); then
      state=absent
    fi

    if ((do_install)); then
      case "${state}" in
        absent)
          if preflight_install_paths "${component}"; then
            state=clean
            installed_in_run=1
          else
            failed=1
          fi
          ;;
        clean)
          ;;
        dirty)
          printf \
            'Cannot install %s: component is dirty or otherwise unexpected.\n' \
            "${component}" >&2
          failed=1
          ;;
      esac
    fi

    if ((do_update && installed_in_run == 0)); then
      case "${state}" in
        absent)
          printf \
            'Cannot update %s: component would not exist at the ' \
            "${component}" >&2
          printf 'update stage.\n' >&2
          failed=1
          ;;
        dirty)
          printf \
            'Cannot update %s: component is dirty or otherwise unexpected.\n' \
            "${component}" >&2
          failed=1
          ;;
        clean)
          ;;
      esac
    fi
  done

  if ((failed)); then
    printf \
      'No changes were made. Adjust the selected components or resolve the ' >&2
    printf 'reported state first.\n' >&2
    return 1
  fi
}

list_components() {
  local component
  local exists
  local dirty
  local path

  for component in "${selected_components[@]}"; do
    if component_call exists "${component}"; then
      exists=true
      if component_call dirty "${component}"; then
        dirty=true
      else
        dirty=false
      fi
    else
      exists=false
      dirty=null
    fi

    printf '%s:\n' "${component}"
    printf '  exists: %s\n' "${exists}"
    printf '  dirty: %s\n' "${dirty}"
    printf '  paths:\n'

    while IFS= read -r path; do
      printf '    - '
      yaml_quote "${path}"
      printf '\n'
    done < <(component_call paths "${component}")
  done
}

nuke_components() {
  local component
  local path
  local reply
  local nuke_paths=()

  for component in "${selected_components[@]}"; do
    while IFS= read -r path; do
      if path_exists "${path}" &&
        { ((${#nuke_paths[@]} == 0)) ||
          ! contains "${path}" "${nuke_paths[@]}"; }; then
        nuke_paths+=("${path}")
      fi
    done < <(component_call paths "${component}")
  done

  if ((${#nuke_paths[@]} == 0)); then
    printf 'Nothing to remove.\n'
    return
  fi

  if ! exec 3<>/dev/tty 2>/dev/null; then
    printf \
      'Cannot run --nuke: no controlling terminal is available.\n' >&2
    return 1
  fi

  printf 'The following paths will be removed recursively:\n\n' >&3

  for path in "${nuke_paths[@]}"; do
    printf '  %s\n' "${path}" >&3
  done

  printf '\nType "yes" to continue: ' >&3

  reply=""
  IFS= read -r reply <&3 || true

  if [[ "${reply}" != yes ]]; then
    printf 'Aborted.\n' >&3
    exec 3>&-
    return 1
  fi

  printf '\nRemoving managed paths...\n' >&3

  for path in "${nuke_paths[@]}"; do
    rm -rf -- "${path}"
  done

  exec 3>&-
  printf 'Done.\n'
}


install_components() {
  local component

  for component in "${selected_components[@]}"; do
    if component_call exists "${component}"; then
      continue
    fi

    printf 'Installing %s...\n' "${component}"
    component_call install "${component}"
    installed_components+=("${component}")
    changed_components+=("${component}")
  done
}

update_components() {
  local component

  for component in "${selected_components[@]}"; do
    if ((${#installed_components[@]})) &&
      contains "${component}" "${installed_components[@]}"; then
      continue
    fi

    printf 'Updating %s...\n' "${component}"
    component_call update "${component}"
    changed_components+=("${component}")
  done
}

run_post_hooks() {
  local component

  if ((${#changed_components[@]} == 0)); then
    return
  fi

  for component in "${changed_components[@]}"; do
    component_call post "${component}"
  done
}


if ((do_list)); then
  list_components
fi

if ((do_nuke || do_install || do_update)); then
  preflight
fi

if ((dry_run)); then
  exit 0
fi

if ((do_nuke)); then
  nuke_components
fi

installed_components=()
changed_components=()

if ((do_install)); then
  install_components
fi

if ((do_update)); then
  update_components
fi

run_post_hooks
